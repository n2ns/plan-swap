{
  "name": "planswap",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.3.8",
  "publisher": "n2ns",
  "private": true,
  "license": "MIT",
  "icon": "resources/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/n2ns/plan-swap.git"
  },
  "bugs": {
    "url": "https://github.com/n2ns/plan-swap/issues"
  },
  "homepage": "https://github.com/n2ns/plan-swap#readme",
  "engines": {
    "vscode": "^1.107.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "planswap.switchAccount",
        "title": "%command.switchAccount%",
        "category": "%category.claude%",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "planswap.addAccount",
        "title": "%command.addAccount%",
        "category": "%category.claude%",
        "icon": "$(add)"
      },
      {
        "command": "planswap.shareAccount",
        "title": "%command.shareAccount%",
        "category": "%category.claude%",
        "icon": "$(link)"
      },
      {
        "command": "planswap.removeAccount",
        "title": "%command.removeAccount%",
        "category": "%category.claude%",
        "icon": "$(trash)"
      },
      {
        "command": "planswap.openTerminal",
        "title": "%command.openTerminal%",
        "category": "%category.claude%",
        "icon": "$(terminal)"
      },
      {
        "command": "planswap.openSettings",
        "title": "%command.openSettings%",
        "category": "%category.tools%",
        "icon": "$(settings-gear)"
      },
      {
        "command": "planswap.refresh",
        "title": "%command.refresh%",
        "category": "%category.claude%",
        "icon": "$(refresh)"
      },
      {
        "command": "planswap.codex.enable",
        "title": "%command.codex.enable%",
        "category": "%category.codex%",
        "icon": "$(check)"
      },
      {
        "command": "planswap.codex.disable",
        "title": "%command.codex.disable%",
        "category": "%category.codex%",
        "icon": "$(circle-slash)"
      },
      {
        "command": "planswap.codex.switchAccount",
        "title": "%command.codex.switchAccount%",
        "category": "%category.codex%",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "planswap.codex.addAccount",
        "title": "%command.codex.addAccount%",
        "category": "%category.codex%",
        "icon": "$(add)"
      },
      {
        "command": "planswap.codex.shareAccount",
        "title": "%command.codex.shareAccount%",
        "category": "%category.codex%",
        "icon": "$(link)"
      },
      {
        "command": "planswap.codex.removeAccount",
        "title": "%command.codex.removeAccount%",
        "category": "%category.codex%",
        "icon": "$(trash)"
      },
      {
        "command": "planswap.codex.openTerminal",
        "title": "%command.codex.openTerminal%",
        "category": "%category.codex%",
        "icon": "$(terminal)"
      },
      {
        "command": "planswap.codex.restartServer",
        "title": "%command.codex.restartServer%",
        "category": "%category.codex%",
        "icon": "$(debug-restart)"
      },
      {
        "command": "planswap.claude.refreshAllUsage",
        "title": "%command.claude.refreshAllUsage%",
        "category": "%category.claude%",
        "icon": "$(refresh)"
      },
      {
        "command": "planswap.claude.refreshUsage",
        "title": "%command.claude.refreshUsage%",
        "category": "%category.claude%",
        "icon": "$(refresh)"
      },
      {
        "command": "planswap.codex.refreshUsage",
        "title": "%command.codex.refreshUsage%",
        "category": "%category.codex%",
        "icon": "$(refresh)"
      },
      {
        "command": "planswap.codex.refreshAllUsage",
        "title": "%command.codex.refreshAllUsage%",
        "category": "%category.codex%",
        "icon": "$(refresh)"
      },
      {
        "command": "planswap.tools.openClaudeMd",
        "title": "%command.tools.openClaudeMd%",
        "category": "%category.tools%",
        "icon": "$(symbol-ruler)"
      },
      {
        "command": "planswap.tools.openAgentsMd",
        "title": "%command.tools.openAgentsMd%",
        "category": "%category.tools%",
        "icon": "$(symbol-ruler)"
      },
      {
        "command": "planswap.tools.openSettings",
        "title": "%command.tools.openSettings%",
        "category": "%category.tools%",
        "icon": "$(settings-gear)"
      },
      {
        "command": "planswap.tools.reloadWindow",
        "title": "%command.tools.reloadWindow%",
        "category": "%category.tools%",
        "icon": "$(refresh)"
      },
      {
        "command": "planswap.tools.restartExtHost",
        "title": "%command.tools.restartExtHost%",
        "category": "%category.tools%",
        "icon": "$(debug-restart)"
      },
      {
        "command": "planswap.tools.cliVersions",
        "title": "%command.tools.cliVersions%",
        "category": "%category.tools%",
        "icon": "$(info)"
      },
      {
        "command": "planswap.tools.diagnostics",
        "title": "%command.tools.diagnostics%",
        "category": "%category.tools%",
        "icon": "$(pulse)"
      },
      {
        "command": "planswap.tools.sync",
        "title": "%command.tools.sync%",
        "category": "%category.tools%",
        "icon": "$(sync)"
      }
    ],
    "configuration": [
      {
        "id": "planswap",
        "title": "%config.group.general%",
        "order": 0,
        "properties": {
          "planswap.language": {
            "type": "string",
            "enum": [
              "auto",
              "en",
              "zh-cn",
              "zh-tw",
              "es",
              "ja"
            ],
            "default": "auto",
            "scope": "application",
            "enumDescriptions": [
              "%config.language.auto%",
              "%config.language.en%",
              "%config.language.zhCn%",
              "%config.language.zhTw%",
              "%config.language.es%",
              "%config.language.ja%"
            ],
            "description": "%config.language.description%",
            "order": 0
          },
          "planswap.usageDisplay": {
            "type": "string",
            "enum": [
              "remaining",
              "used"
            ],
            "default": "remaining",
            "scope": "application",
            "enumDescriptions": [
              "%config.usageDisplay.remaining%",
              "%config.usageDisplay.used%"
            ],
            "description": "%config.usageDisplay.description%",
            "order": 1
          },
          "planswap.usageWarningThreshold": {
            "type": "number",
            "default": 30,
            "minimum": 0,
            "maximum": 100,
            "scope": "application",
            "description": "%config.usageWarningThreshold.description%",
            "order": 2
          },
          "planswap.usageErrorThreshold": {
            "type": "number",
            "default": 10,
            "minimum": 0,
            "maximum": 100,
            "scope": "application",
            "description": "%config.usageErrorThreshold.description%",
            "order": 3
          },
          "planswap.usageAutoRefreshCurrentOnly": {
            "type": "boolean",
            "default": false,
            "scope": "application",
            "description": "%config.usageAutoRefreshCurrentOnly.description%",
            "order": 4
          },
          "planswap.notifications.enabled": {
            "type": "boolean",
            "default": true,
            "scope": "application",
            "description": "%config.notificationsEnabled.description%",
            "order": 5
          },
          "planswap.notifications.threshold": {
            "type": "number",
            "default": 20,
            "minimum": 1,
            "maximum": 99,
            "scope": "application",
            "description": "%config.notificationsThreshold.description%",
            "order": 6
          }
        }
      },
      {
        "id": "planswap.sidebar",
        "title": "%config.group.sidebar%",
        "order": 1,
        "properties": {
          "planswap.sidebar.shortFormat": {
            "type": "boolean",
            "default": false,
            "scope": "application",
            "description": "%config.sidebarShortFormat.description%",
            "order": 0
          },
          "planswap.sidebar.showEmail": {
            "type": "boolean",
            "default": true,
            "scope": "application",
            "description": "%config.sidebarEmail.description%",
            "order": 1
          },
          "planswap.sidebar.showFiveHourLimit": {
            "type": "boolean",
            "default": true,
            "scope": "application",
            "description": "%config.sidebarFiveHour.description%",
            "order": 2
          },
          "planswap.sidebar.showWeeklyLimit": {
            "type": "boolean",
            "default": true,
            "scope": "application",
            "description": "%config.sidebarWeekly.description%",
            "order": 3
          },
          "planswap.sidebar.showModelLimits": {
            "type": "boolean",
            "default": false,
            "scope": "application",
            "description": "%config.sidebarModelLimits.description%",
            "order": 4
          },
          "planswap.sidebar.showRecommendation": {
            "type": "boolean",
            "default": true,
            "scope": "application",
            "description": "%config.sidebarRecommendation.description%",
            "order": 5
          },
          "planswap.sidebar.recommendationThreshold": {
            "type": "number",
            "default": 10,
            "minimum": 0,
            "maximum": 100,
            "scope": "application",
            "description": "%config.sidebarRecommendationThreshold.description%",
            "order": 6
          }
        }
      },
      {
        "id": "planswap.statusBar",
        "title": "%config.group.statusBar%",
        "order": 2,
        "properties": {
          "planswap.statusBar.enabled": {
            "type": "boolean",
            "default": true,
            "scope": "application",
            "description": "%config.statusBarEnabled.description%",
            "order": 0
          },
          "planswap.statusBar.products": {
            "type": "string",
            "enum": [
              "both",
              "claude",
              "codex"
            ],
            "default": "both",
            "scope": "application",
            "enumDescriptions": [
              "%config.statusBarProducts.both%",
              "%config.statusBarProducts.claude%",
              "%config.statusBarProducts.codex%"
            ],
            "description": "%config.statusBarProducts.description%",
            "order": 1
          },
          "planswap.statusBar.alignment": {
            "type": "string",
            "enum": [
              "left",
              "right"
            ],
            "default": "right",
            "scope": "application",
            "enumDescriptions": [
              "%config.statusBarAlignment.left%",
              "%config.statusBarAlignment.right%"
            ],
            "description": "%config.statusBarAlignment.description%",
            "order": 2
          }
        }
      },
      {
        "id": "planswap.accounts",
        "title": "%config.group.accounts%",
        "order": 3,
        "properties": {
          "planswap.claude.confirmSwitch": {
            "type": "boolean",
            "default": true,
            "scope": "application",
            "description": "%config.claudeConfirmSwitch.description%",
            "order": 0
          },
          "planswap.claude.usageAutoRefresh": {
            "type": "boolean",
            "default": true,
            "scope": "application",
            "description": "%config.claudeUsageAutoRefresh.description%",
            "order": 1
          },
          "planswap.claude.usageRefreshMinutes": {
            "type": "number",
            "default": 15,
            "minimum": 10,
            "maximum": 1440,
            "scope": "application",
            "description": "%config.claudeUsageRefreshMinutes.description%",
            "order": 2
          },
          "planswap.codex.usageAutoRefresh": {
            "type": "boolean",
            "default": true,
            "scope": "application",
            "description": "%config.codexUsageAutoRefresh.description%",
            "order": 3
          },
          "planswap.codex.usageRefreshMinutes": {
            "type": "number",
            "default": 15,
            "minimum": 5,
            "maximum": 1440,
            "scope": "application",
            "description": "%config.codexUsageRefreshMinutes.description%",
            "order": 4
          }
        }
      },
      {
        "id": "planswap.advanced",
        "title": "%config.group.advanced%",
        "order": 4,
        "properties": {
          "planswap.usageCheckIntervalSeconds": {
            "type": "number",
            "default": 120,
            "minimum": 30,
            "maximum": 600,
            "scope": "application",
            "description": "%config.usageCheckIntervalSeconds.description%",
            "order": 0
          },
          "planswap.claude.usageTimeoutSeconds": {
            "type": "number",
            "default": 30,
            "minimum": 10,
            "maximum": 120,
            "scope": "application",
            "description": "%config.claudeUsageTimeoutSeconds.description%",
            "order": 1
          },
          "planswap.codex.usageTimeoutSeconds": {
            "type": "number",
            "default": 15,
            "minimum": 5,
            "maximum": 120,
            "scope": "application",
            "description": "%config.codexUsageTimeoutSeconds.description%",
            "order": 2
          }
        }
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "planswap",
          "title": "%viewContainer.title%",
          "icon": "resources/account.svg"
        }
      ]
    },
    "views": {
      "planswap": [
        {
          "type": "webview",
          "id": "planswap.accounts",
          "name": "%view.name%"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "planswap.openSettings",
          "when": "view == planswap.accounts",
          "group": "navigation@1"
        },
        {
          "command": "planswap.refresh",
          "when": "view == planswap.accounts",
          "group": "navigation@2"
        }
      ]
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/webview && tsc --noEmit -p test",
    "test": "node scripts/run-tests.mjs",
    "test:integration": "npm run build && node scripts/run-integration.mjs",
    "test:ui": "npm run build && node scripts/run-ui-tests.mjs",
    "preview": "npm run build && node scripts/preview/server.mjs",
    "perf": "node scripts/run-perf.mjs",
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "vscode:prepublish": "npm run typecheck && npm run build",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "@types/vscode": "1.107.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2",
    "playwright": "1.63.0",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@vscode-elements/elements": "2.5.1",
    "@vscode/codicons": "0.0.45"
  },
  "keywords": [
    "claude code",
    "codex",
    "account switcher",
    "switch account",
    "multi-account",
    "subscription",
    "plan",
    "claude",
    "chatgpt",
    "anthropic",
    "openai",
    "wsl"
  ]
}
