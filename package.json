{
  "name": "planswap",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.2.1",
  "publisher": "n2ns",
  "private": true,
  "license": "MIT",
  "icon": "resources/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/n2ns/planswap.git"
  },
  "bugs": {
    "url": "https://github.com/n2ns/planswap/issues"
  },
  "homepage": "https://github.com/n2ns/planswap#readme",
  "engines": {
    "vscode": "^1.107.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "planswap.switchAccount",
        "title": "%command.switchAccount%",
        "category": "%category.claude%",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "planswap.addAccount",
        "title": "%command.addAccount%",
        "category": "%category.claude%",
        "icon": "$(add)"
      },
      {
        "command": "planswap.shareAccount",
        "title": "%command.shareAccount%",
        "category": "%category.claude%",
        "icon": "$(link)"
      },
      {
        "command": "planswap.removeAccount",
        "title": "%command.removeAccount%",
        "category": "%category.claude%",
        "icon": "$(trash)"
      },
      {
        "command": "planswap.openTerminal",
        "title": "%command.openTerminal%",
        "category": "%category.claude%",
        "icon": "$(terminal)"
      },
      {
        "command": "planswap.refresh",
        "title": "%command.refresh%",
        "category": "%category.claude%",
        "icon": "$(refresh)"
      },
      {
        "command": "planswap.codex.enable",
        "title": "%command.codex.enable%",
        "category": "%category.codex%",
        "icon": "$(check)"
      },
      {
        "command": "planswap.codex.disable",
        "title": "%command.codex.disable%",
        "category": "%category.codex%",
        "icon": "$(circle-slash)"
      },
      {
        "command": "planswap.codex.switchAccount",
        "title": "%command.codex.switchAccount%",
        "category": "%category.codex%",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "planswap.codex.addAccount",
        "title": "%command.codex.addAccount%",
        "category": "%category.codex%",
        "icon": "$(add)"
      },
      {
        "command": "planswap.codex.shareAccount",
        "title": "%command.codex.shareAccount%",
        "category": "%category.codex%",
        "icon": "$(link)"
      },
      {
        "command": "planswap.codex.removeAccount",
        "title": "%command.codex.removeAccount%",
        "category": "%category.codex%",
        "icon": "$(trash)"
      },
      {
        "command": "planswap.codex.openTerminal",
        "title": "%command.codex.openTerminal%",
        "category": "%category.codex%",
        "icon": "$(terminal)"
      },
      {
        "command": "planswap.codex.restartServer",
        "title": "%command.codex.restartServer%",
        "category": "%category.codex%",
        "icon": "$(debug-restart)"
      },
      {
        "command": "planswap.claude.refreshUsage",
        "title": "%command.claude.refreshUsage%",
        "category": "%category.claude%",
        "icon": "$(refresh)"
      },
      {
        "command": "planswap.codex.refreshUsage",
        "title": "%command.codex.refreshUsage%",
        "category": "%category.codex%",
        "icon": "$(refresh)"
      },
      {
        "command": "planswap.tools.openClaudeMd",
        "title": "%command.tools.openClaudeMd%",
        "category": "%category.tools%",
        "icon": "$(symbol-ruler)"
      },
      {
        "command": "planswap.tools.openAgentsMd",
        "title": "%command.tools.openAgentsMd%",
        "category": "%category.tools%",
        "icon": "$(symbol-ruler)"
      },
      {
        "command": "planswap.tools.openSettings",
        "title": "%command.tools.openSettings%",
        "category": "%category.tools%",
        "icon": "$(settings-gear)"
      },
      {
        "command": "planswap.tools.reloadWindow",
        "title": "%command.tools.reloadWindow%",
        "category": "%category.tools%",
        "icon": "$(refresh)"
      },
      {
        "command": "planswap.tools.restartExtHost",
        "title": "%command.tools.restartExtHost%",
        "category": "%category.tools%",
        "icon": "$(debug-restart)"
      },
      {
        "command": "planswap.tools.cliVersions",
        "title": "%command.tools.cliVersions%",
        "category": "%category.tools%",
        "icon": "$(info)"
      },
      {
        "command": "planswap.tools.diagnostics",
        "title": "%command.tools.diagnostics%",
        "category": "%category.tools%",
        "icon": "$(pulse)"
      },
      {
        "command": "planswap.tools.sync",
        "title": "%command.tools.sync%",
        "category": "%category.tools%",
        "icon": "$(sync)"
      }
    ],
    "configuration": {
      "title": "%config.title%",
      "properties": {
        "planswap.language": {
          "type": "string",
          "enum": [
            "auto",
            "en",
            "zh-cn",
            "es",
            "ja"
          ],
          "default": "auto",
          "scope": "application",
          "enumDescriptions": [
            "%config.language.auto%",
            "%config.language.en%",
            "%config.language.zhCn%",
            "%config.language.es%",
            "%config.language.ja%"
          ],
          "description": "%config.language.description%"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "planswap",
          "title": "%viewContainer.title%",
          "icon": "resources/account.svg"
        }
      ]
    },
    "views": {
      "planswap": [
        {
          "type": "webview",
          "id": "planswap.accounts",
          "name": "%view.name%"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "planswap.refresh",
          "when": "view == planswap.accounts",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/webview && tsc --noEmit -p test",
    "test": "node scripts/run-tests.mjs",
    "test:integration": "npm run build && node scripts/run-integration.mjs",
    "test:ui": "npm run build && node scripts/run-ui-tests.mjs",
    "preview": "npm run build && node scripts/preview/server.mjs",
    "perf": "node scripts/run-perf.mjs",
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "vscode:prepublish": "npm run typecheck && npm run build",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "@types/vscode": "1.107.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2",
    "playwright": "1.63.0",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@vscode-elements/elements": "2.5.1",
    "@vscode/codicons": "0.0.45"
  },
  "keywords": [
    "claude code",
    "codex",
    "account switcher",
    "switch account",
    "multi-account",
    "subscription",
    "plan",
    "claude",
    "chatgpt",
    "anthropic",
    "openai",
    "wsl"
  ]
}
